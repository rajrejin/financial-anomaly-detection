# syntax=docker/dockerfile:1
# Multi-stage, CPU only, non-root. The exported model directory is baked in (immutable image).
ARG PYTHON_IMAGE=python:3.13-slim-bookworm

FROM ${PYTHON_IMAGE} AS builder
ARG FAMILY=isolation_forest
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_NO_CACHE_DIR=1
WORKDIR /build
COPY requirements-serving.txt ./
RUN python -m venv /opt/venv && /opt/venv/bin/pip install -r requirements-serving.txt
# Family specific extras: CPU torch for the autoencoder; lightgbm or xgboost plus SHAP for trees.
RUN if [ "$FAMILY" = "autoencoder" ]; then       /opt/venv/bin/pip install --extra-index-url https://download.pytorch.org/whl/cpu torch==2.14.1;     elif [ "$FAMILY" = "lightgbm" ]; then       /opt/venv/bin/pip install lightgbm==4.7.0 shap==0.54.1;     elif [ "$FAMILY" = "xgboost" ]; then       /opt/venv/bin/pip install xgboost==3.4.1 shap==0.54.1;     fi
COPY pyproject.toml ./
COPY src ./src
RUN /opt/venv/bin/pip install --no-deps .

FROM ${PYTHON_IMAGE} AS runtime
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PATH=/opt/venv/bin:$PATH \
    ANOMALY_MODEL_DIR=/app/models_export FINANOMALY_ROOT=/app MPLCONFIGDIR=/tmp/mpl
RUN groupadd --system --gid 10001 app && useradd --system --uid 10001 --gid app --no-create-home app
WORKDIR /app
COPY --from=builder /opt/venv /opt/venv
COPY configs ./configs
COPY api ./api
COPY --chown=app:app models_export ./models_export
USER 10001
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/v1/health', timeout=4).status == 200 else 1)"
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
