# syntax=docker/dockerfile:1
FROM python:3.13-slim-bookworm
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_NO_CACHE_DIR=1
RUN pip install mlflow==3.17.1 \
 && groupadd --system --gid 10001 app && useradd --system --uid 10001 --gid app --create-home app \
 && mkdir -p /mlflow && chown app:app /mlflow
USER 10001
WORKDIR /mlflow
EXPOSE 5000
CMD ["mlflow", "server", "--host", "0.0.0.0", "--port", "5000", \
     "--backend-store-uri", "sqlite:////mlflow/mlflow.db", \
     "--artifacts-destination", "/mlflow/artifacts", "--serve-artifacts", "--workers", "1", \
     "--allowed-hosts", "mlflow:5000,localhost:5000,127.0.0.1:5000"]
